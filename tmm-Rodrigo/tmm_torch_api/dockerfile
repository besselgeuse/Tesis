FROM python:3.12.2-slim

# Instalar dependencias del sistema necesarias para procesamiento numérico (PyTorch/OpenMP)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Copiar solo requerimientos
COPY requirements.txt .

# 2. Instalar PyTorch CPU para portabilidad universal y ligereza
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# 3. Instalar el resto de dependencias de requirements.txt (excluyendo la línea de torch local)
RUN grep -v "torch" requirements.txt > requirements_docker.txt && \
    pip install --no-cache-dir -r requirements_docker.txt

# 4. Copiar todo el código fuente al contenedor
COPY . .

# 5. Ejecutar la aplicación FastAPI usando uvicorn de manera correcta
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]